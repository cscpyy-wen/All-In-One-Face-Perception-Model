demo/__tmp_app__/
demo/infer_outputs/
demo/batch_results/
demo/direct_results/

# ---- Temp / cache ----
_tmp/
_wheels/
*.tmp
*.bak

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Claude Code ----
.claude/

# ---- Environment ----
moeface_env_freeze.txt
